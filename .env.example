# -----------------------------------------------------------------------------
# Syncora — Environment Configuration Template
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Fill in the values from your Supabase Dashboard (Settings > API).
# -----------------------------------------------------------------------------

# =============================================================================
# Client-Side Public Keys (Safe to expose to browser, protected by Supabase RLS)
# =============================================================================

# Your Supabase project URL (e.g., https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable Key (New format: sb_publishable_...; safe for client bundles)
# Backward compatible with legacy NEXT_PUBLIC_SUPABASE_ANON_KEY if needed
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key-here

# Base URL of the application for generating shareable watch party invitation links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Server-Only Privileged Secrets (NEVER prefix with NEXT_PUBLIC_)
# =============================================================================

# Supabase Secret Key (New format: sb_secret_...; bypasses RLS; used strictly in server actions/handlers)
# Backward compatible with legacy SUPABASE_SERVICE_ROLE_KEY if needed.
# Keep this secret. DO NOT expose to client bundles, browser code, or git.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here

