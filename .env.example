# -----------------------------------------------------------------------------
# Syncora — Environment Configuration Template
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Fill in the values from your Supabase Dashboard (Settings > API).
# -----------------------------------------------------------------------------

# =============================================================================
# Client-Side Public Keys (Safe to expose to browser, protected by Supabase RLS)
# =============================================================================

# Your Supabase project URL (e.g., https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable Key (New format: sb_publishable_...; safe for client bundles)
# Backward compatible with legacy NEXT_PUBLIC_SUPABASE_ANON_KEY if needed
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key-here

# Base URL of the application for generating shareable watch party invitation links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Server-Only Privileged Secrets (NEVER prefix with NEXT_PUBLIC_)
# =============================================================================

# Supabase Secret Key (New format: sb_secret_...; bypasses RLS; used strictly in server actions/handlers)
# Backward compatible with legacy SUPABASE_SERVICE_ROLE_KEY if needed.
# Keep this secret. DO NOT expose to client bundles, browser code, or git.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here

# YouTube Data API v3 key (server-only; used by /api/youtube/search and /api/youtube/videos)
# Create/restrict this key in Google Cloud Console and enable "YouTube Data API v3".
# NEVER prefix with NEXT_PUBLIC_.
YOUTUBE_API_KEY=

# Shared Bearer token protecting /api/cron/cleanup (required in production)
# Generate e.g. with: openssl rand -hex 32
# CRON_SECRET=your-cron-secret-here

# =============================================================================
# WebRTC Voice Calling — Server-Only TURN Relay (Optional in dev, Required in prod)
# =============================================================================
# When CLOUDFLARE_TURN_KEY_ID and CLOUDFLARE_TURN_API_TOKEN are omitted, Syncora
# falls back to STUN-only mode for local development testing.
# WARNING: STUN-only is NOT production-ready — mobile CGNAT (e.g. Jio) and strict
# firewalls frequently block peer-to-peer UDP without a TURN relay.
# NEVER prefix these variables with NEXT_PUBLIC_.

# Provider mode: 'cloudflare' (auto-selected when Cloudflare keys are set) or 'stun-only'
# TURN_PROVIDER=cloudflare

# Cloudflare Realtime TURN Key ID and Bearer Token (from Cloudflare Calls/Realtime dashboard)
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=

# Short-lived credential TTL in seconds (clamped between 300 and 86400; default 3600)
# TURN_CREDENTIAL_TTL_SECONDS=3600

# Optional comma-separated STUN URLs used in STUN-only development mode
# STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302

