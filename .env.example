# -----------------------------------------------------------------------------
# Syncora — Environment Configuration Template
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Fill in the values from your Supabase Dashboard (Settings > API).
# -----------------------------------------------------------------------------

# =============================================================================
# Client-Side Public Keys (Safe to expose to browser, protected by Supabase RLS)
# =============================================================================

# Your Supabase project URL (e.g., https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase public anonymous API key (safe for client bundles)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Base URL of the application for generating shareable watch party invitation links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Server-Only Privileged Secrets (NEVER prefix with NEXT_PUBLIC_)
# =============================================================================

# Supabase service role key (bypasses RLS; used strictly in server actions/handlers)
# Keep this secret. DO NOT expose to client bundles or git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

